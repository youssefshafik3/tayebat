# ==============================================================================
# Tayebat Frontend Environment Configuration
# Copy this file to `.env.local` in `final/frontend/` before running if you
# want to connect to a live SQL Server instance.
# ==============================================================================

# Database mode:
# - "mock"  : Uses the built-in in-memory database pre-loaded with final/seed_data.sql
#             (Great for exploring the UI immediately without SQL Server running)
# - "mssql" : Connects server-side API routes to your SQL Server Milestone 2 database
DB_MODE=mock

# SQL Server Connection Settings (only needed when DB_MODE=mssql)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=LocalDeliveryMarketplace_Team_00
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Secret used by the Next.js server to sign login session cookies
SESSION_SECRET=tayebat-local-dev-secret-change-me
